{
  "name": "wallet-platform/woocommerce-wallet",
  "description": "Ledger-first closed-loop wallet platform for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {"php": ">=8.2"},
  "require-dev": {
    "php-stubs/woocommerce-stubs": "^11.1",
    "php-stubs/wordpress-stubs": "^6.9",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {"psr-4": {"WalletPlatform\\": "src/"}},
  "scripts": {"test": "php tests/run.php", "test:phpunit": "phpunit", "analyse": "phpstan analyse --memory-limit=1G", "lint": "php tools/lint.php", "package": "php tools/package.php"},
  "config": {"sort-packages": true, "allow-plugins": false}
}
